@inject IOrderFetcher Orders

@page "/order/{Id:guid}"
@using TIN.Core.Dtos.Order
@using TIN.Frontend.Api

@code{
    [Parameter]
    public Guid Id { get; init; }
    
    GetOrderDto? _order;

    protected override async Task OnInitializedAsync()
    {
        _order = await Orders.GetOrderAsync(Id);
    }
}

<PageTitle>@(_order?.Id.ToString() ?? "Error")</PageTitle>

@if (_order == null)
{
    <p> No such order </p>
} else {
    <table class="table">
        <thead>
        <tr>
            <th class="w-auto">Id</th>
            <th class="w-auto">Order Date</th>
            <th class="w-auto">Completion Date</th>
            <th class="w-auto">Order Status</th>
            <th class="w-auto">Customer</th>
            <th class="w-auto"></th>
        </tr>
        </thead>

        <tbody>
        <tr>
            <td><a href="order/@_order.Id" class="h4"></a></td>
            <td>@_order.OrderDate.ToShortDateString()</td>
            <td>@(_order.CompletionDate?.ToShortDateString() ?? "Not completed")</td>
            <td>@_order.OrderStatus</td>
            <td>@_order.Customer.UserName</td>
            <td>
                <a class="btn btn-warning" href="order/@_order.Id/edit">Edit</a>
                <a class="btn btn-danger" href="order/@_order.Id/delete">Remove</a>
            </td>
        </tr>
        </tbody>
    </table>
    
    <table class="table">
        <thead>
        <th class="w-auto"> Product Id </th>
        <th class="w-auto"> Product Name </th>
        <th class="w-auto"> Quantity </th>
        <th class="w-auto"> Total Price </th>
        </thead>
        
        <tbody>
        @foreach (var item in _order.Products)
        {
            <tr>
                <td><a class="h4" href="product/@item.Product.ProductId">@item.Product.ProductId</a></td>
                <td>@item.Product.Name</td>
                <td>@item.Quantity</td>
                <td>@(item.Product.Price * item.Quantity) $</td>
            </tr>
        }
        </tbody>
    </table>
}