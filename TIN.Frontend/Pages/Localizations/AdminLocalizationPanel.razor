@page "/admin/localizations/"
@using System.Net
@using TIN.Core.Dtos
@using TIN.Core.Dtos.Product
@using TIN.Frontend.Api

@inject IProductFetcher Products;

<AuthorizeView Roles="Administrator">
    <Authorized>
    <PageTitle>Localizations</PageTitle>

    @code{
        List<GetProductDto>? _products;

        protected override async Task OnInitializedAsync()
        {
            var products = await Products.GetAllProductsAsync(_dto);

            if (products != null)
                _products = [.. products];
            else
                _products = [];
        }
        
        PaginationDto _dto = new();
        
        async Task Prev()
        {
            _dto.Page--;
            if (_dto.Page <= 1) 
                _dto.Page = 1;
            await OnInitializedAsync();
        }

        async Task Next()
        {
            _dto.Page++;
            await OnInitializedAsync();
        }
    }
    
    <EditForm Model="_dto">
        <ChildContent Context="editContext">
            <button class="btn btn-info" @onclick="Prev"> Previous </button>
             @_dto.Page 
            <button class="btn btn-info" @onclick="Next"> Next </button> <br/>
                
            <br/> <select class="form-select form-select-sm w-auto" @bind="_dto.PageSize" @bind:after="OnInitializedAsync">
                <option value="1">1</option>
                <option value="5">5</option>
                <option value="10">10</option>
                <option value="25">25</option>
                <option value="25">50</option>
                <option value="@(int.MaxValue)">All</option> <br/>
            </select>
        </ChildContent>
    </EditForm>

    @if (_products == null)
    {
        <p> Loading... </p>
    }
    else if (_products.Count == 0)
    {
        <p> No products yet :( </p>
    }
    else
    {
        <table class="table">
            <thead>
            <tr>
                <th class="w-15">Name</th>
                <th class="w-15">Image</th>
                <th>Description</th>
                <th class="w-15">Price</th>
                <th class="w-auto"></th>
            </tr>
            </thead>

            <tbody>
            @foreach (var product in _products)
            {
                <tr>
                    <td><a href="localization/@product.ProductId" class="h4">@product.Name</a></td>
                    <td><img class="preview-image" alt="Image of @product.Name" src="@product.ImageUri"></td>
                    <td>@(product.Description ?? "No description available.")</td>
                    <td>@product.Price $</td>
                </tr>
            }
            </tbody>
        </table>
    }
    </Authorized>
    <NotAuthorized>
        @(HttpStatusCode.Unauthorized)
    </NotAuthorized>
</AuthorizeView>