@inject IUserFetcher Users
@inject StatusService Status

@page "/admin/users"
@using System.Net
@using TIN.Core.Dtos
@using TIN.Core.Dtos.User
@using TIN.Frontend.Api

<PageTitle>Admin User Panel</PageTitle>

<AuthorizeView Roles="Administrator">
    <Authorized>

    @code {
        List<GetUserDto>? _users;
        
        protected override async Task OnInitializedAsync()
        {
            var users = await Users.GetAllUsersAsync(_dto);

            if (users == null)
                _users = [];
            else
                _users = [.. users];
        }

        async Task MakeAdmin(Guid id)
        {
            try
            {
                await Users.MakeAdminAsync(id);
            }
            catch (HttpRequestException e)
            {
                await Status.SetStatusAsync(e.ToErrorString(), StatusService.StatusType.Error);
            }
        }

        PaginationDto _dto = new();
        
        async Task Prev()
        {
            _dto.Page--;
            if (_dto.Page <= 1) 
                _dto.Page = 1;
            await OnInitializedAsync();
        }

        async Task Next()
        {
            _dto.Page++;
            await OnInitializedAsync();
        }
    }
    
    <EditForm Model="_dto">
        <ChildContent Context="editContext">
            <button class="btn btn-info" @onclick="Prev"> Previous </button>
             @_dto.Page 
            <button class="btn btn-info" @onclick="Next"> Next </button> <br/>
                
            <br/> <select class="form-select form-select-sm w-auto" @bind="_dto.PageSize" @bind:after="OnInitializedAsync">
                <option value="1">1</option>
                <option value="5">5</option>
                <option value="10">10</option>
                <option value="25">25</option>
                <option value="25">50</option>
                <option value="@(int.MaxValue)">All</option> <br/>
            </select>
        </ChildContent>
    </EditForm>

    @if (_users == null)
    {
        <p> Loading... </p>
    }
    else if (_users.Count == 0)
    {
        <p> No users here :( </p>
    }
    else
    {
        
        <table class="table">
            <thead>
            <th class="w-auto"> Name </th>
            <th class="w-auto"> Role </th>
            <th class="w-auto"></th>
            <th class="w-auto"></th>
            </thead>

            <tbody>
            @foreach (var user in _users)
            {
                <tr>
                    <td>@user.UserName</td>
                    <td>@user.UserRole</td>
                    <td>
                        <a class="btn btn-info" href="user/@user.UserId"> View </a>
                        <button class="btn btn-info" onclick="@(() => MakeAdmin(user.UserId))"> Make admin </button>
                        @*<a class="btn btn-info" href="user/@user.UserId/edit"> Edit </a>
                    <a class="btn btn-info" href="user/@user.UserId/delete"> Remove </a>*@
                    </td>
                </tr>
            }
            </tbody>
        </table>
    }
    </Authorized>
    <NotAuthorized>
        @(HttpStatusCode.Unauthorized)
    </NotAuthorized>
</AuthorizeView>