@using TIN.Core.Exceptions
@using TIN.Frontend.Api
@using TIN.Frontend.Auth
@using TIN.Frontend.Cart

@inject ICartService CartService
@inject IOrderFetcher Orders
@inject NavigationManager Nav;
@inject StatusService Status
@inject JwtAuthStateProvider Auth

@page "/cart"

<PageTitle>Catalogue</PageTitle>

@code{
    List<CartItem> _products = [];
    
    protected override async Task OnInitializedAsync()
    {
        await RefreshCart();
    }
    
    async Task RefreshCart()
    {
        _products = await CartService.GetCartAsync();
    }

    async Task Increase(CartItem item)
    {
        await CartService.AddToCart(item);
        await RefreshCart();
    }
    
    async Task Decrease(CartItem item)
    {
        await CartService.DeleteFromCart(item);
        await RefreshCart();
    }
    
    async Task Clear()
    {
        await CartService.ClearCart();
        await RefreshCart();
    }

    async Task Order()
    {
        try
        {
            var data = await Auth.GetAuthenticationStateAsync();

            if (data.User.Identity == null)
                throw new BadRequestException();
            
            var id = await Orders.CreateOrder(_products, data.User.Identity.Name!);
            Nav.NavigateTo($"/order/{id}");
        }
        catch (HttpRequestException e)
        {
            await Status.SetStatusAsync(e.ToErrorString(), StatusService.StatusType.Error);
        } catch (BadRequestException)
        {
            await Status.SetStatusAsync("Log in required", StatusService.StatusType.Error);
        }
    }
}

@if (_products.Count == 0) {
    <p> No products yet :( </p>
}
else
{
    <table class="table">
        <thead>
        <tr>
            <th class="w-15">Name</th>
            <th class="w-25">Image</th>
            <th class="w-15">Quantity</th>
            <th class="w-15">Price</th>
            <th class="w-auto"></th>
        </tr>
        </thead>
        
        <tbody>
        @foreach (var product in _products)
        {
            <tr>
                <td><a href="product/@product.ProductId" class="h4">@product.Name</a></td>
                <td><img class="preview-image" alt="Image of @product.Name" src="@product.ImageUri"></td>
                <td>@product.Quantity</td>
                <td>@product.Price $ </td>
                <td>
                    <button class="align-content-center btn btn-info" @onclick="() => Increase(product)">+</button>
                    <button class="align-content-center btn btn-warning" @onclick="() => Decrease(product)">-</button>
                </td>
            </tr>
        }
        </tbody>
    </table>
    
    <AuthorizeView Roles="Customer, Admin">
        <Authorized>
        <button class="align-content-center btn btn-success" @onclick="Order">Order</button>
        </Authorized>
        <NotAuthorized>
            <h5>Please <a href="authentication/login">log in</a> first</h5>
        </NotAuthorized>
    </AuthorizeView>
    <button class="align-content-center btn btn-danger" @onclick="Clear">Clear cart</button>
}
