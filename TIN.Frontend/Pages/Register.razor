@page "/authentication/register"
@using TIN.Core.Dtos.User
@using TIN.Frontend.Auth

@inject AuthApiService Auth
@inject NavigationManager Nav
@inject StatusService Status

<h3>Login</h3>

@code {
    RegisterUserDto _dto = new();

    async Task LoginAsync()
    {
        try
        {
            await Auth.RegisterAsync(_dto);
            Nav.NavigateTo("/authentication/login");
        }
        catch (HttpRequestException e)
        {
            await Status.SetStatusAsync(e.ToErrorString(), StatusService.StatusType.Error);
        }
    }
}

<EditForm Model="_dto" OnValidSubmit="LoginAsync">
    <DataAnnotationsValidator />
    <ValidationSummary/>

    <label> Username </label>
    <InputText class="form-control" @bind-Value="_dto.UserName"> </InputText>
    
    <label> Password </label>
    <InputText class="form-control" @bind-Value="_dto.Password" type="password"> </InputText>
    
    <label> Repeat password </label>
    <InputText class="form-control" @bind-Value="_dto.PasswordRepeat" type="password"> </InputText>
</EditForm>

<br/>
<button class="btn btn-success" @onclick="LoginAsync"> Register </button> 