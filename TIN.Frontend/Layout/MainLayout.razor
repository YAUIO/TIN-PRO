@inherits LayoutComponentBase

@inject StatusService StatusService;

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4 auth">
            <LoginDisplay />
            <a href="cart">Cart</a>
        </div>
        
        <a href=""><h1 class="text-center header-text">PC Store Application</h1></a>

        <article class="content px-4">
            @if (!string.IsNullOrEmpty(StatusService.Status))
            {
                <div class="alert @StatusService.CssClass mt-2">@StatusService.Status</div>
            }
            
            @Body
        </article>
    </main>
</div>

@code
{
    protected override void OnInitialized()
    {
        StatusService.OnChange += StateHasChanged;
    }
    
    public void Dispose()
    {
        StatusService.OnChange -= StateHasChanged;
    }
}
